{
  "name": "@astratest/react-native",
  "version": "0.1.0",
  "description": "In-app bug reporting for Astra Test. Testers report from inside your app; a screenshot, requests, logs and device details are attached.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "homepage": "https://astratest.dev",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node test/payload.test.mjs",
    "prepublishOnly": "tsc && node test/payload.test.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-view-shot": ">=3.6"
  },
  "peerDependenciesMeta": {
    "react-native-view-shot": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kiswani/astra-test-react-native"
  },
  "keywords": [
    "bug reporting",
    "uat",
    "feedback",
    "react-native",
    "astra test"
  ],
  "publishConfig": {
    "access": "public"
  }
}
